# =============================================================================
# MLOps Pipeline Environment Configuration Template (.env.example)
# =============================================================================

# --- Cloud Storage (OCI / AWS S3 / GCP GCS) ---
CLOUD_BUCKET=your-bucket-name
S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=ap-singapore-1

# JSON format for GitHub Actions secret CLOUD_CREDENTIALS
CLOUD_CREDENTIALS='{"aws_access_key_id":"your-access-key-id","aws_secret_access_key":"your-secret-access-key"}'

# --- Remote VM Deployment Configuration ---
VM_HOST=your-vm-ip-or-domain
VM_PORT=22
VM_USER=root
VM_PASSWORD=your-vm-password
VM_SSH_KEY_PATH=~/.ssh/id_rsa

# --- MLflow & Inference Serving Configuration ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=wine_quality_prediction
MODEL_LOCAL_PATH=models/model.pkl
HOST=0.0.0.0
PORT=8000
